  if (!uid) return false;
  const col = role === "driver" ? "drivers" : "customers";
  const doc = await fsGet(env, col + "/" + encodeURIComponent(uid), access);
  if (!doc || !doc.fields.fcmToken) return false;
  const res = await sendFCM(env, doc.fields.fcmToken, platformOf(doc.fields), data, access);
  if (!res.ok && res.dead) await clearDeadToken(env, col, uid, access, doc.fields.fcmToken);
  return res.ok;
}
function normPrefs(p) {
  const out = {};
  ADMIN_TYPES.forEach(t => { out[t] = !(p && p[t] === false); });
  return out;
}
async function adminDevices(env, access) {
  try {
    return await fsQuery(env, { from: [{ collectionId: "adminDevices" }], limit: 100 }, access);
  } catch (e) { console.error("[TruckConnect] adminDevices", e.message); return []; }
}
async function notifyAdmins(env, access, type, title, body, extra) {
  const rows = await adminDevices(env, access);
  let sent = 0;
  await Promise.all(rows.map(async r => {
    const f = r.fields;
    if (!f.token) return;
    if (f.prefs && f.prefs[type] === false) return;
    const res = await sendFCM(env, f.token, "web", Object.assign({
      kind: "admin_" + type, title, body, app: "admin", screen: ADMIN_TAB[type] || "",
      tag: (extra && extra.tag) || ("tc-admin-" + type + "-" + Date.now()),
      bookingId: (extra && extra.bookingId) || ""
    }, {}), access);
    if (res.ok) sent++;
    else if (res.dead) await fsDelete(env, "adminDevices/" + r.id, access);
  }));
  if (sent) { try { await fsSet(env, "config/adminNotifyState", { lastEventAt: new Date().toISOString() }, access); } catch (e) {} }
  return sent;
}

/* ---------- admin app routes (replaces the separate admin worker) ---------- */
function jwtPayload(request) {
  try { return JSON.parse(new TextDecoder().decode(decode64(bearer(request).split(".")[1]))); } catch { return {}; }
}
async function adminLogin(request, env) {
  /* No notify key needed: a valid Firebase login that belongs to an admin is enough,
     so a new laptop or phone works as soon as you sign in. */
  if (!bearer(request)) throw err(401, "no_login");
  let user;
  try { user = await firebaseUser(request, env); } catch { throw err(401, "bad_login"); }
  const email = String(jwtPayload(request).email || "").toLowerCase();
  const emails = String(env.ADMIN_EMAILS || "admin@truckconnect.co.za").toLowerCase().split(/[\s,;]+/).filter(Boolean);
  const uids = ADMIN_DEFAULT_UIDS.concat(String(env.ADMIN_UIDS || "").split(/[\s,;]+/).filter(Boolean));
  if (!(email && emails.includes(email)) && !uids.includes(user.localId)) throw err(403, "not_admin");
  return user;
}
async function adminConfig(request, env) {
  await adminLogin(request, env);
  return json({ ok: true, vapidKey: env.VAPID_PUBLIC_KEY || DEFAULT_VAPID });
}
async function adminRegister(request, env) {
  const user = await adminLogin(request, env);
  const body = await readBody(request);
  const token = String(body.token || "");
  if (token.length < 20) throw err(400, "bad_token");
  const access = await googleToken(env);
  if (body.oldToken && body.oldToken !== token) await fsDelete(env, "adminDevices/" + (await sha1hex(String(body.oldToken))), access);
  const id = await sha1hex(token);
  const cur = await fsGet(env, "adminDevices/" + id, access);
  const prefs = normPrefs(body.prefs || (cur && cur.fields.prefs) || {});
  await fsSet(env, "adminDevices/" + id, { token, label: String(body.label || "Device").slice(0, 80), uid: user.localId, prefs, updatedAt: new Date().toISOString() }, access);
  return json({ ok: true, prefs });
}
async function adminUnregister(request, env) {
  await adminLogin(request, env);
  const body = await readBody(request);
  const access = await googleToken(env);
  if (body.token) await fsDelete(env, "adminDevices/" + (await sha1hex(String(body.token))), access);
  return json({ ok: true });
}
async function adminStatus(request, env) {
  await adminLogin(request, env);
  const body = await readBody(request);
  const access = await googleToken(env);
  const rows = await adminDevices(env, access);
  const mine = body.token ? rows.find(r => r.fields.token === body.token) : null;
  let last = null;
  try { const st = await fsGet(env, "config/adminNotifyState", access); last = st && st.fields.lastEventAt; } catch (e) {}
  return json({ ok: true, devices: rows.length, lastEventAt: last, mine: mine ? { prefs: normPrefs(mine.fields.prefs) } : null });
}
async function adminPrefs(request, env) {
  await adminLogin(request, env);
  const body = await readBody(request);
  const token = String(body.token || "");
  const access = await googleToken(env);
  const id = await sha1hex(token);
  const cur = await fsGet(env, "adminDevices/" + id, access);
  if (!cur) throw err(404, "device_not_found");
  const prefs = normPrefs(body.prefs || {});
  await fsPatch(env, "adminDevices/" + id, { prefs, updatedAt: new Date().toISOString() }, access);
  return json({ ok: true, prefs });
}
async function adminTest(request, env) {
  await adminLogin(request, env);
  const body = await readBody(request);
  const type = String(body.type || "");
  if (!ADMIN_SAMPLES[type]) throw err(400, "bad_type");
  const access = await googleToken(env);
  const cur = await fsGet(env, "adminDevices/" + (await sha1hex(String(body.token || ""))), access);
  if (!cur || !cur.fields.token) throw err(404, "device_not_found");
  const res = await sendFCM(env, cur.fields.token, "web", { kind: "admin_" + type, title: ADMIN_SAMPLES[type][0], body: ADMIN_SAMPLES[type][1], app: "admin", screen: ADMIN_TAB[type] || "", tag: "tc-admin-test-" + Date.now() }, access);
  if (!res.ok) throw err(502, "push_failed_" + res.status);
  return json({ ok: true });
}
async function adminRun(request, env) {
  await adminLogin(request, env);
  const r = await runSweeps(env);
  return json({ ok: true, sent: r.sent, checked: r.checked, events: r.events });
}

/* ---------- apps report events here: POST /event ---------- */
async function appEvent(request, env) {
  const user = await firebaseUser(request, env);
  const body = await readBody(request);
  const type = String(body.type || "");
  const def = CATALOG[type];
  if (!def) throw err(400, "Unknown event type");
  const access = await googleToken(env);
  const ov = await catalogOverrides(env, access);
  if (ov[type + "__off"] === true) return json({ ok: true, sent: 0, reason: "disabled" });
  const safe = {};
  Object.entries(body.vars || {}).forEach(([k, v]) => { safe[k] = String(v == null ? "" : v).slice(0, 140); });
  let vars = Object.assign({ name: "", msg: "", sender: "" }, safe);
  let b = null, bookingId = String(body.bookingId || "");
  if (def.booking) {
    if (!bookingId) throw err(400, "bookingId is required");
    const doc = await fsGet(env, "bookings/" + encodeURIComponent(bookingId), access);
    if (!doc) throw err(404, "Booking not found");
    b = doc.fields;
    if (b.customerUid !== user.localId && b.driverUid !== user.localId) throw err(403, "Not your booking");
    vars = Object.assign(bookingVars(b, bookingId), safe);
    if (!vars.sender) vars.sender = b.customerUid === user.localId ? (b.customerName || "Customer") : (b.driverName || "Driver");
  }
  const results = {};
  const pick = (aud, k) => ov[type + "__" + aud + "__" + k] || def[aud][k];
  const build = (aud, role) => ({
    kind: type, title: fill(pick(aud, "title"), vars), body: fill(pick(aud, "body"), vars),
    screen: def[aud].screen || "", bookingId, id: bookingId, app: role, tag: "tc-" + type + "-" + (bookingId || user.localId)
  });
  if (b) {
    const callerIsCustomer = b.customerUid === user.localId;
    if (def.customer) results.customer = await pushToUser(env, access, "customer", b.customerUid, build("customer", "customer"));
    if (def.driver && b.driverUid) results.driver = await pushToUser(env, access, "driver", b.driverUid, build("driver", "driver"));
    if (def.other) {
      const toUid = callerIsCustomer ? b.driverUid : b.customerUid;
      results.other = await pushToUser(env, access, callerIsCustomer ? "driver" : "customer", toUid, build("other", callerIsCustomer ? "driver" : "customer"));
    }
  }
  if (def.admin && !(b && def.admin.pref === "cancelled" && b.adminNotified_cancelled === true)) {
    if (b && def.admin.pref === "cancelled") await fsPatch(env, "bookings/" + encodeURIComponent(bookingId), { adminNotified_cancelled: true }, access).catch(() => {});
    results.admin = await notifyAdmins(env, access, def.admin.pref, fill(pick("admin", "title"), vars), fill(pick("admin", "body"), vars), { tag: "tc-" + type + "-" + (bookingId || user.localId), bookingId });
  }
  return json({ ok: true, type, results });
}

/* ---------- admin copies of the notifications the apps already send ---------- */
async function withAdminTap(handler, mode, request, env, ctx) {
  const clone = request.clone();
  const res = await handler(request, env);
  try {
    if (res.status < 300) ctx.waitUntil(adminTap(mode, clone, env).catch(e => console.error("[TruckConnect] adminTap", e.message)));
  } catch (e) {}
  return res;
}
async function adminTap(mode, request, env) {
  let body = {};
  try { body = await request.json(); } catch { return; }
  const access = await googleToken(env);
  if (mode === "newjob") {
    const id = String(body.bookingId || "");
    const doc = id && await fsGet(env, "bookings/" + encodeURIComponent(id), access);
    if (!doc || doc.fields.ds !== "avail" || doc.fields.adminNotified === true) return;
    const b = doc.fields, v = bookingVars(b, id);
    const n = await notifyAdmins(env, access, "booking", b.heavy ? "🏗 Heavy load request" : "📦 New booking",
      v.ref + ": " + v.from + " → " + v.to + (b.heavy ? " · " + v.size + " ton · " + v.cargo : (v.price ? " · " + v.price : "")), { bookingId: id, tag: "tc-booking-" + id });
    if (n) await fsPatch(env, "bookings/" + encodeURIComponent(id), { adminNotified: true }, access).catch(() => {});
  } else if (mode === "fromapp") {
    const kind = String((body.data && body.data.kind) || "").toLowerCase() + " " + String(body.title || "").toLowerCase();
    const id = String(body.bookingId || (body.data && body.data.id) || "");
    let type = "";
    if (/complet|deliver/.test(kind)) type = "completed";
    else if (/cancel/.test(kind)) type = "cancelled";
    else if (/accept|confirm/.test(kind)) type = "accepted";
    if (!type || !id) return;
    const doc = await fsGet(env, "bookings/" + encodeURIComponent(id), access);
    if (!doc) return;
    const v = bookingVars(doc.fields, id);
    const marker = "adminNotified_" + type;
    if (doc.fields[marker] === true) return;
    const titles = { completed: "✅ Load completed", cancelled: "❌ Load cancelled", accepted: "🚛 Driver accepted" };
    const n = await notifyAdmins(env, access, type, titles[type], v.ref + ": " + v.from + " → " + v.to + (v.price ? " · " + v.price : "") + (v.driver && type !== "cancelled" ? " · " + v.driver : ""), { bookingId: id, tag: "tc-" + type + "-" + id });
    if (n) await fsPatch(env, "bookings/" + encodeURIComponent(id), { [marker]: true }, access).catch(() => {});
  } else if (mode === "self") {
    const role = String(body.role || "");
    if (role !== "driver" && role !== "customer") return;
    const user = await firebaseUser(request, env).catch(() => null);
    if (!user) return;
    const col = role === "driver" ? "drivers" : "customers";
    const doc = await fsGet(env, col + "/" + encodeURIComponent(user.localId), access);
    if (!doc || doc.fields.adminSignupNotified === true) return;
    /* only a brand-new account counts as a signup (made in the last 3 hours) */
    if (!doc.createTime || Date.now() - Date.parse(doc.createTime) > 3 * 3600000) {
      await fsPatch(env, col + "/" + encodeURIComponent(user.localId), { adminSignupNotified: true }, access).catch(() => {});
      return;
    }
    const f = doc.fields, name = f.name || f.fullName || f.email || "Someone";
    const n = await notifyAdmins(env, access, role === "driver" ? "driver" : "customer",
      role === "driver" ? "🚛 New driver application" : "👤 New customer", name + (role === "driver" ? " applied to drive." : " just signed up."), { tag: "tc-signup-" + user.localId });
    if (n) await fsPatch(env, col + "/" + encodeURIComponent(user.localId), { adminSignupNotified: true }, access).catch(() => {});
  }
}

/* ---------- scheduled sweeps (Cron Trigger) ---------- */
async function runSweeps(env) {
  const access = await googleToken(env);
  const out = { sent: 0, checked: 0, events: {} };
  const now = Date.now();
  const bump = (k, n) => { out.sent += n ? 1 : 0; out.events[k] = (out.events[k] || 0) + (n ? 1 : 0); };

  /* 1. pickup reminders (accepted trips starting within the hour) */
  try {
    const rows = await fsQuery(env, { from: [{ collectionId: "bookings" }], where: filter("ds", "EQUAL", { stringValue: "accepted" }), limit: 150 }, access);
    for (const r of rows) {
      out.checked++;
      const b = r.fields, t = Number(b.pickupTimestamp) || 0;
      if (!t || b.rem1hSent === true || t < now || t - now > 65 * 60000) continue;
      const v = bookingVars(b, r.id), ov = await catalogOverrides(env, access);
      if (ov.pickup_reminder__off === true) continue;
      const c = await pushToUser(env, access, "customer", b.customerUid, { kind: "pickup_reminder", title: fill(CATALOG.pickup_reminder.customer.title, v), body: fill(CATALOG.pickup_reminder.customer.body, v), screen: "track", bookingId: r.id, id: r.id, app: "customer", tag: "tc-rem-" + r.id });
      const d = await pushToUser(env, access, "driver", b.driverUid, { kind: "pickup_reminder", title: fill(CATALOG.pickup_reminder.driver.title, v), body: fill(CATALOG.pickup_reminder.driver.body, v), screen: "job", bookingId: r.id, id: r.id, app: "driver", tag: "tc-rem-" + r.id });
      await fsPatch(env, "bookings/" + encodeURIComponent(r.id), { rem1hSent: true }, access).catch(() => {});
      bump("reminder", c || d);
    }
  } catch (e) { console.error("[TruckConnect] sweep reminders", e.message); }

  /* 2. open requests nobody took (45 min normal, 24 h heavy) */
  try {
    const rows = await fsQuery(env, { from: [{ collectionId: "bookings" }], where: filter("ds", "EQUAL", { stringValue: "avail" }), limit: 150 }, access);
    for (const r of rows) {
      out.checked++;
      const b = r.fields, made = Date.parse(b.created || "") || 0;
      const limit = (b.heavy === true ? 24 * 60 : 45) * 60000;
      if (!made || b.expiredNotified === true || now - made < limit) continue;
      const v = bookingVars(b, r.id);
      const c = await pushToUser(env, access, "customer", b.customerUid, { kind: "request_expired", title: b.heavy ? "No quotes yet" : fill(CATALOG.request_expired.customer.title, v), body: b.heavy ? "No truck has sent a quote for " + v.from + " → " + v.to + ". Open the app to adjust your request." : fill(CATALOG.request_expired.customer.body, v), screen: "home", bookingId: r.id, id: r.id, app: "customer", tag: "tc-exp-" + r.id });
      const a = await notifyAdmins(env, access, "alert", "⏳ " + (b.heavy ? "Heavy load with no quote" : "Load with no driver"), v.ref + ": " + v.from + " → " + v.to, { bookingId: r.id, tag: "tc-exp-" + r.id });
      await fsPatch(env, "bookings/" + encodeURIComponent(r.id), { expiredNotified: true }, access).catch(() => {});
      bump("expired", c || a);
    }
  } catch (e) { console.error("[TruckConnect] sweep expired", e.message); }

  /* 3. driver documents + subscription expiring */
  try {
    const rows = await fsQuery(env, { from: [{ collectionId: "drivers" }], where: filter("status", "EQUAL", { stringValue: "approved" }), limit: 400 }, access);
    for (const r of rows) {
      out.checked++;
      const f = r.fields;
      if (!f.fcmToken) continue;
      const checks = [["prdpExpiry", "PrDP", "expNotif_prdp", "doc_expiring", [30, 7, 1]], ["discExpiry", "Vehicle disc", "expNotif_disc", "doc_expiring", [30, 7, 1]], ["paidUntil", "", "expNotif_paid", "subscription_ending", [3, 1]]];
      for (const [field, label, flag, type, steps] of checks) {
        const exp = Date.parse(f[field] || "");
        if (!exp) continue;
        const days = Math.ceil((exp - now) / 86400000);
        const stage = days <= 0 ? 0 : steps.find(s => days <= s);
        if (stage === undefined) continue;
        const prev = f[flag] === undefined || f[flag] === null || f[flag] === "" ? null : Number(f[flag]);
        if (prev !== null && prev <= stage) continue;
        const when = days <= 0 ? "has expired" : days === 1 ? "expires tomorrow" : "expires in " + days + " days";
        const t = CATALOG[type].driver;
        const ok = await pushToUser(env, access, "driver", r.id, { kind: type, title: fill(t.title, { doc: label, when: type === "subscription_ending" ? (days <= 0 ? "ended" : days === 1 ? "ends tomorrow" : "ends in " + days + " days") : when }), body: t.body, screen: t.screen, app: "driver", tag: "tc-" + type + "-" + field });
        await fsPatch(env, "drivers/" + encodeURIComponent(r.id), { [flag]: stage }, access).catch(() => {});
        bump(type, ok);
      }
    }
  } catch (e) { console.error("[TruckConnect] sweep expiry", e.message); }
  return out;
}
