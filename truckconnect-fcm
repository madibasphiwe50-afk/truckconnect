   NEW JOB
   ========================= */

async function notifyNewJob(request, env) {
  const user = await firebaseUser(request, env);
  const body = await readBody(request);

  const bookingId = String(body.bookingId || "");

  if (!bookingId) throw err(400, "bookingId is required");

  const access = await googleToken(env);

  const doc = await fsGet(
    env,
    "bookings/" + encodeURIComponent(bookingId),
    access
  );

  if (!doc) throw err(404, "Booking not found");

  const b = doc.fields;

  if (b.customerUid !== user.localId)
    throw err(403, "You do not own this booking");

  console.log("[TruckConnect] notify-new-job booking=" + bookingId + " ds=" + b.ds + " caller=" + user.localId);

  let allDrivers;

  if (b.ds === "requested" && b.driverUid) {
    const one = await fsGet(env, "drivers/" + encodeURIComponent(b.driverUid), access);

    allDrivers =
      one && one.fields.fcmToken
        ? [{ id: b.driverUid, fields: one.fields }]
        : [];

    console.log("[TruckConnect] chosen driver " + b.driverUid + " hasToken=" + allDrivers.length);
  } else if (b.ds === "avail") {
    allDrivers = await eligibleDrivers(env, b, access);
  } else {
    return json({
      ok: true,
      sent: 0,
      reason: "booking-not-available",
      ds: b.ds
    });
  }

  const heavy = b.heavy === true && b.ds === "avail";
  const drivers = allDrivers.slice(0, heavy ? 40 : MAX_DRIVERS_PER_JOB);

  const bodyText = [
    b.from ? "Pickup: " + b.from : "",
    b.to ? "Destination: " + b.to : "",
    b.heavy === true
      ? "Heavy load " + (b.heavySize || "") + " ton" + (b.cargo ? " · " + b.cargo : "")
      : b.price ? "Fare: " + formatRand(b.price) : ""
  ]
    .filter(Boolean)
    .join(" • ");

  const results = await Promise.all(
    drivers.map(async d => {
      const actionToken = heavy ? undefined : await makeActionToken(env, d.id, bookingId);

      const result = await sendFCM(
        env,
        d.fields.fcmToken,
        platformOf(d.fields),
        {
          kind: heavy ? "heavy_request" : "new_job",
          title: heavy ? "🏗 Heavy Load: send your quote" : "🚛 New Truck Request",
          body: bodyText || "A new truck request is available.",
          bookingId,
          id: bookingId,
          screen: "job",
          app: "driver",
          tag: "tc-job-" + bookingId,
          actionToken
        },
        access
      );

      if (!result.ok && result.dead) {
        await clearDeadToken(env, "drivers", d.id, access, d.fields.fcmToken);
      }

      if (!result.ok) {
        console.error("[TruckConnect] push failed", d.id, result.status, result.error);
      }

      return result.ok;
    })
  );

  const sent = results.filter(Boolean).length;

  return json({
    ok: true,
    bookingId,
    sent,
    candidates: allDrivers.length,
    notified: drivers.length,
    failed: results.length - sent
  });
}

