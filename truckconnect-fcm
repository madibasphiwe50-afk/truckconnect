   ADMIN: /broadcast and /notify
   Authorization: Bearer <ADMIN_API_SECRET>
   ========================= */

function requireAdmin(request, env) {
  if (!env.ADMIN_API_SECRET) throw err(500, "ADMIN_API_SECRET is missing");

  const given = bearer(request);

  return Promise.all([hmac(given, "tc-admin"), hmac(env.ADMIN_API_SECRET, "tc-admin")]).then(
    ([a, b]) => {
      if (!constantTime(a, b)) throw err(401, "Invalid admin secret");
    }
  );
}

async function pushMany(env, rows, access, title, body, extra) {
  const seen = new Set();
  const todo = [];

  for (const r of rows) {
    const t = r.fields.fcmToken;
    if (!t || seen.has(t)) continue;
    seen.add(t);
    todo.push(r);
  }

  const capped = todo.slice(0, 40);

  const results = await Promise.all(
    capped.map(async r => {
      const res = await sendFCM(
        env,
        r.fields.fcmToken,
        platformOf(r.fields),
        Object.assign(
          {
            kind: "admin",
            title: String(title).slice(0, 100),
            body: String(body).slice(0, 300),
            screen: "home",
            app: r.collection === "drivers" ? "driver" : "customer",
            tag: "tc-admin-" + Date.now()
          },
          extra || {}
        ),
        access
      );

      if (!res.ok && res.dead)
        await clearDeadToken(env, r.collection, r.id, access, r.fields.fcmToken);

      if (!res.ok)
        console.error("[TruckConnect] admin push failed", r.collection, r.id, res.status, res.error);

      return res.ok;
    })
  );

  return {
    sent: results.filter(Boolean).length,
    attempted: capped.length,
    withToken: todo.length,
    truncated: todo.length > capped.length
  };
}

async function adminBroadcast(request, env) {
  await requireAdmin(request, env);

  const body = await readBody(request);
  const target = String(body.target || "all");
  const title = String(body.title || "").trim();
  const text = String(body.body || "").trim();

  if (!title) throw err(400, "title is required");
  if (!["all", "drivers", "customers", "approved"].includes(target))
    throw err(400, "invalid target");

  const access = await googleToken(env);
  const rows = [];

  if (target === "all" || target === "drivers" || target === "approved") {
    const q = { from: [{ collectionId: "drivers" }], limit: 500 };

    if (target === "approved")
      q.where = and([filter("status", "EQUAL", { stringValue: "approved" })]);

    (await fsQuery(env, q, access)).forEach(d =>
      rows.push({ collection: "drivers", id: d.id, fields: d.fields })
    );
  }

  if (target === "all" || target === "customers") {
    (await fsQuery(env, { from: [{ collectionId: "customers" }], limit: 500 }, access)).forEach(
      d => rows.push({ collection: "customers", id: d.id, fields: d.fields })
    );
  }

  console.log("[TruckConnect] broadcast target=" + target + " docs=" + rows.length);

  const out = await pushMany(env, rows, access, title, text);

  return json({ ok: true, ...out });
}

async function adminNotify(request, env) {
  await requireAdmin(request, env);

  const body = await readBody(request);
  const toUid = String(body.toUid || "");
  const role = String(body.role || "");

  if (!toUid || (role !== "driver" && role !== "customer"))
    throw err(400, "toUid and role (driver|customer) are required");

  const access = await googleToken(env);
  const collection = role === "driver" ? "drivers" : "customers";
  const doc = await fsGet(env, collection + "/" + encodeURIComponent(toUid), access);

  if (!doc || !doc.fields.fcmToken) {
    return json({ ok: false, sent: 0, reason: "no-fcm-token" });
  }

  const extra = {};

  for (const k of ALLOWED_DATA_KEYS)
    if (body.data && body.data[k] != null) extra[k] = String(body.data[k]).slice(0, 200);

  const out = await pushMany(
    env,
    [{ collection, id: toUid, fields: doc.fields }],
    access,
    body.title || "TruckConnect",
    body.body || "",
    extra
  );

  return json({ ok: out.sent > 0, ...out, reason: out.sent > 0 ? undefined : "fcm-error" });
}


