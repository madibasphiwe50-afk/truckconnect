async function fsSet(env, path, fields, token) {
  const r = await fetch(fsBase(env) + ":commit", {
    method: "POST",
    headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
    body: JSON.stringify({ writes: [{ update: { name: fsName(env, path), fields: fsFields(fields) }, updateMask: { fieldPaths: Object.keys(fields).filter(k => fields[k] !== undefined) } }] })
  });
  if (!r.ok) throw new Error("Firestore set failed: " + r.status + " " + (await r.text()).slice(0, 300));
}
async function fsDelete(env, path, token) {
  await fetch(fsBase(env) + ":commit", {
    method: "POST",
    headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
    body: JSON.stringify({ writes: [{ delete: fsName(env, path) }] })
  });
}
