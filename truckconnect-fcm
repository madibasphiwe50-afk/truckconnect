/* =====================================================================
   TruckConnect FCM Worker  (web + native app)

   Required secrets / variables:
     FIREBASE_SERVICE_ACCOUNT  - full service-account JSON
     ADMIN_API_SECRET          - long random string (signs action tokens)
     FIREBASE_WEB_API_KEY      - no longer used (tokens verified locally)

   FIX (Oct 2026): fsPatch() sent the document "name" as a full https://
   URL. Firestore's commit API needs the resource name
   (projects/.../documents/...). Every Firestore WRITE from this Worker
   therefore failed, which is why tapping Accept on the push showed
   "Could not accept the job". Reads worked, so pushes still arrived.

   FIX (Oct 2026): the fare in the driver's new-job notification showed
   "RR1,500" (double R) because the stored price already contained an "R"
   and the worker added another. Prices now go through formatRand(), which
   strips any existing R / ZAR, and always outputs a single "R" with
   thousands separators (R1,500). fixRand() also cleans a double R in
   notification text sent from the apps.
   ===================================================================== */

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Admin-Notify-Key",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Max-Age": "86400",
  "Content-Type": "application/json"
};

const PUSH_TTL_SECONDS = 120;
const ACTION_TOKEN_SECONDS = 180;
const ANDROID_CHANNEL_ID = "tc_jobs";
const MAX_DRIVERS_PER_JOB = 25;

const ALLOWED_DATA_KEYS = [
  "kind",
  "screen",
  "id",
  "bookingId",
  "tag",
  "status",
  "price",
  "eta"
];

const NATIVE_PLATFORMS = [
  "native",
  "android",
  "ios",
  "app",
  "capacitor",
  "cordova",
  "apk"
];

/* =========================
   NOTIFICATION LOGO
   The logo is served by this Worker itself:
     GET /logo.png    512x512 blue square  (notification icon, web)
     GET /badge.png   96x96 white on transparent (Android web status-bar badge)
     GET /banner.png  1024x512 blue banner (big image on native Android)
   Set SHOW_BANNER_ON_NATIVE to false if the big banner is too much.
   ========================= */

const LOGO_B64 = "";
const BANNER_B64 = "";
const BADGE_B64 = "";

const SHOW_BANNER_ON_NATIVE = true;

let ORIGIN = ""; // set from the incoming request, e.g. https://xxx.workers.dev

function assetResponse(b64) {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);

  return new Response(bytes, {
    status: 200,
    headers: {
      "Content-Type": "image/png",
      "Cache-Control": "public, max-age=86400",
      "Access-Control-Allow-Origin": "*"
    }
  });
}

export default {
  async fetch(request, env, ctx) {
    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: CORS });
    }

    const url = new URL(request.url);

    ORIGIN = url.origin;

    try {
      if (request.method === "GET" && url.pathname === "/logo.png")
        return assetResponse(LOGO_B64);

      if (request.method === "GET" && url.pathname === "/badge.png")
        return assetResponse(BADGE_B64);

      if (request.method === "GET" && url.pathname === "/banner.png")
        return assetResponse(BANNER_B64);

      if (request.method === "GET" && url.pathname === "/health") {
        const sa = getSA(env);
        return json({
          ok: true,
          service: "TruckConnect FCM Worker",
          projectId: sa.project_id,
          hasAdminSecret: !!env.ADMIN_API_SECRET
        });
      }

      if (request.method === "GET" && url.pathname === "/config")
        return await adminConfig(request, env);

      if (request.method !== "POST") {
        return json({ error: "Method not allowed" }, 405);
      }

      if (url.pathname === "/register") return await adminRegister(request, env);
      if (url.pathname === "/unregister") return await adminUnregister(request, env);
      if (url.pathname === "/status") return await adminStatus(request, env);
      if (url.pathname === "/prefs") return await adminPrefs(request, env);
      if (url.pathname === "/test") return await adminTest(request, env);
      if (url.pathname === "/run") return await adminRun(request, env);
      if (url.pathname === "/event") return await appEvent(request, env);

      if (url.pathname === "/notify-new-job")
        return await withAdminTap(notifyNewJob, "newjob", request, env, ctx);

      if (url.pathname === "/notify-from-app")
        return await withAdminTap(notifyFromApp, "fromapp", request, env, ctx);

      if (url.pathname === "/notify-self")
        return await withAdminTap((r, e) => notifySelf(r, e, ctx), "self", request, env, ctx);

      if (url.pathname === "/broadcast")
        return await adminBroadcast(request, env);

      if (url.pathname === "/notify")
        return await adminNotify(request, env);

      if (url.pathname === "/notification-action")
        return await notificationAction(request, env);

      return json({ error: "Not found" }, 404);
    } catch (e) {
      console.error("[TruckConnect]", e);
      return json(
        { error: e.message || "Internal server error" },
        e.status || 500
      );
    }
  },

  async scheduled(event, env, ctx) {
    ctx.waitUntil(runSweeps(env).catch(e => console.error("[TruckConnect] sweep", e)));
  }
};

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: CORS
  });
}

function err(status, message) {
  const e = new Error(message);
  e.status = status;
  return e;
}

function bearer(request) {
  const h = request.headers.get("Authorization") || "";
  return h.startsWith("Bearer ") ? h.slice(7).trim() : "";
}

async function readBody(request) {
  try {
    const b = await request.json();
    return b && typeof b === "object" ? b : {};
  } catch {
    throw err(400, "Invalid JSON body");
  }
}

/* =========================
   MONEY FORMATTING
   ========================= */

/* Turns 1500, "1500", "1,500", "R1,500", "R 1500", "ZAR 1500",
   "1500.50" into "R1,500" / "R1,500.50". Always exactly one "R". */
function formatRand(value) {
  if (value === null || value === undefined) return "";

  let s = String(value)
    .replace(/zar/gi, "")
    .replace(/r/gi, "")
    .replace(/\s+/g, "")
    .replace(/[^0-9.,-]/g, "");

  if (!s) return "";

  // "1500,50" (comma used as decimal, no dot) -> "1500.50"
  if (!s.includes(".") && /,\d{1,2}$/.test(s)) {
    s = s.replace(",", ".");
  }

  // remaining commas are thousands separators
  s = s.replace(/,/g, "");

  const n = Number(s);
  if (!Number.isFinite(n)) return "";

  const neg = n < 0 ? "-" : "";
  const abs = Math.abs(n);
  const fixed = Number.isInteger(abs) ? String(abs) : abs.toFixed(2);
  const parts = fixed.split(".");
  const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

  return "R" + neg + intPart + (parts[1] ? "." + parts[1] : "");
}

/* Safety net for text written by the apps: "RR1,500" / "R R1,500" /
   "R 1,500" -> "R1,500" */
function fixRand(text) {
  return String(text || "").replace(/(^|[^A-Za-z])R\s*R\s*(?=\d)/g, "$1R");
}

/* =========================
   FIREBASE SERVICE ACCOUNT
   ========================= */

function getSA(env) {
  if (!env.FIREBASE_SERVICE_ACCOUNT)
    throw err(500, "FIREBASE_SERVICE_ACCOUNT is missing");

  let sa;

  try {
    sa = JSON.parse(env.FIREBASE_SERVICE_ACCOUNT);
  } catch {
    throw err(
      500,
      "FIREBASE_SERVICE_ACCOUNT must contain Firebase service-account JSON"
    );
  }

  if (!sa.project_id || !sa.client_email || !sa.private_key) {
    throw err(500, "FIREBASE_SERVICE_ACCOUNT is missing required fields");
  }

  return sa;
}

function project(env) {
  return getSA(env).project_id;
}

/* =========================
   FIREBASE USER AUTH
   (ID token verified locally against Google's public keys)
   ========================= */

let jwksCache = { keys: null, exp: 0 };

async function securetokenKeys() {
  if (jwksCache.keys && jwksCache.exp > Date.now()) return jwksCache.keys;

  const r = await fetch(
    "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"
  );

  if (!r.ok) throw err(500, "Could not load Firebase public keys: " + r.status);

  const j = await r.json();

  jwksCache = { keys: j.keys || [], exp: Date.now() + 3600 * 1000 };

  return jwksCache.keys;
}

async function firebaseUser(request, env) {
  const token = bearer(request);

  if (!token) throw err(401, "Missing Firebase ID token");

  const parts = token.split(".");

  if (parts.length !== 3) throw err(401, "Malformed Firebase ID token");

  let header, payload;

  try {
    header = JSON.parse(new TextDecoder().decode(decode64(parts[0])));
    payload = JSON.parse(new TextDecoder().decode(decode64(parts[1])));
  } catch {
    throw err(401, "Malformed Firebase ID token");
  }

  if (header.alg !== "RS256" || !header.kid)
    throw err(401, "Unsupported Firebase ID token");

  const pid = project(env);
  const now = Math.floor(Date.now() / 1000);

  if (payload.aud !== pid) throw err(401, "ID token is for a different Firebase project");
  if (payload.iss !== "https://securetoken.google.com/" + pid)
    throw err(401, "ID token issuer mismatch");
  if (!payload.sub || typeof payload.sub !== "string") throw err(401, "ID token has no subject");
  if (payload.exp < now - 30) throw err(401, "ID token expired");
  if (payload.iat > now + 300) throw err(401, "ID token issued in the future");

  const keys = await securetokenKeys();
  const jwk = keys.find(k => k.kid === header.kid);

  if (!jwk) {
    jwksCache.exp = 0;
    throw err(401, "ID token signed with unknown key");
  }

  const key = await crypto.subtle.importKey(
    "jwk",
    jwk,
    { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" },
    false,
    ["verify"]
  );

  const ok = await crypto.subtle.verify(
    "RSASSA-PKCS1-v1_5",
    key,
    decode64(parts[2]),
    new TextEncoder().encode(parts[0] + "." + parts[1])
  );

  if (!ok) throw err(401, "Invalid Firebase ID token signature");

  console.log("[TruckConnect] auth ok uid=" + payload.sub);

  return { localId: payload.sub, uid: payload.sub };
}

/* =========================
   GOOGLE ACCESS TOKEN (cached)
   ========================= */

let cachedAccess = { token: "", exp: 0 };

async function googleToken(env) {
  const nowMs = Date.now();

  if (cachedAccess.token && cachedAccess.exp - 300000 > nowMs) {
    return cachedAccess.token;
  }

  const sa = getSA(env);

  const now = Math.floor(nowMs / 1000);

  const header = { alg: "RS256", typ: "JWT" };

  const claim = {
    iss: sa.client_email,
    scope:
      "https://www.googleapis.com/auth/datastore " +
      "https://www.googleapis.com/auth/firebase.messaging",
    aud: "https://oauth2.googleapis.com/token",
    iat: now,
    exp: now + 3600
  };

  const jwt = b64json(header) + "." + b64json(claim);

  const pem = sa.private_key.replace(/\\n/g, "\n").trim();

  const b64 = pem
    .replace("-----BEGIN PRIVATE KEY-----", "")
    .replace("-----END PRIVATE KEY-----", "")
    .replace(/\s+/g, "");

  const der = Uint8Array.from(atob(b64), c => c.charCodeAt(0));

  const key = await crypto.subtle.importKey(
    "pkcs8",
    der,
    { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const signature = await crypto.subtle.sign(
    "RSASSA-PKCS1-v1_5",
    key,
    new TextEncoder().encode(jwt)
  );

  const assertion = jwt + "." + b64url(new Uint8Array(signature));

  const r = await fetch("https://oauth2.googleapis.com/token", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({
      grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
      assertion
    })
  });

  if (!r.ok)
    throw new Error(
      "Google OAuth failed: " + (await r.text()).slice(0, 500)
    );

  const j = await r.json();

  if (!j.access_token) throw new Error("Google access token missing");

  cachedAccess = {
    token: j.access_token,
    exp: nowMs + (Number(j.expires_in) || 3600) * 1000
  };

  return j.access_token;
}

function b64json(v) {
  return b64url(new TextEncoder().encode(JSON.stringify(v)));
}

function b64url(bytes) {
  let s = "";

  for (const b of bytes) s += String.fromCharCode(b);

  return btoa(s)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function decode64(s) {
  s = s.replace(/-/g, "+").replace(/_/g, "/");

  while (s.length % 4) s += "=";

  return Uint8Array.from(atob(s), c => c.charCodeAt(0));
}

/* =========================
   FIRESTORE
   ========================= */

function fsBase(env) {
  return (
    "https://firestore.googleapis.com/v1/projects/" +
    encodeURIComponent(project(env)) +
    "/databases/(default)/documents"
  );
}

/* FIX: the commit API needs the resource name, NOT the https:// URL.
   e.g. projects/truck-connect-c0c67/databases/(default)/documents/bookings/BK-123 */
function fsName(env, path) {
  const clean = String(path)
    .split("/")
    .map(p => {
      try { return decodeURIComponent(p); } catch { return p; }
    })
    .join("/");

  return (
    "projects/" +
    project(env) +
    "/databases/(default)/documents/" +
    clean
  );
}

function fsValue(v) {
  if (v === null) return { nullValue: null };

  if (typeof v === "boolean") return { booleanValue: v };

  if (typeof v === "number") {
    return Number.isInteger(v)
      ? { integerValue: String(v) }
      : { doubleValue: v };
  }

  if (Array.isArray(v)) return { arrayValue: { values: v.map(fsValue) } };

  if (typeof v === "object") return { mapValue: { fields: fsFields(v) } };

  return { stringValue: String(v) };
}

function fsFields(obj) {
  const out = {};

  for (const [k, v] of Object.entries(obj)) {
    if (v !== undefined) out[k] = fsValue(v);
  }

  return out;
}

function readValue(v) {
  if (!v) return null;

  if ("stringValue" in v) return v.stringValue;

  if ("integerValue" in v) return Number(v.integerValue);

  if ("doubleValue" in v) return v.doubleValue;

  if ("booleanValue" in v) return v.booleanValue;

  if ("timestampValue" in v) return v.timestampValue;

  if ("nullValue" in v) return null;

  if ("mapValue" in v) return readFields(v.mapValue.fields || {});

  if ("arrayValue" in v) return (v.arrayValue.values || []).map(readValue);

  return null;
}

function readFields(fields) {
  const out = {};

  for (const [k, v] of Object.entries(fields || {})) out[k] = readValue(v);

  return out;
}

async function fsGet(env, path, token) {
  const r = await fetch(fsBase(env) + "/" + path, {
    headers: { Authorization: "Bearer " + token }
  });

  if (r.status === 404) return null;

  if (!r.ok)
    throw new Error(
      "Firestore GET failed: " + r.status + " " + (await r.text()).slice(0, 500)
    );

  const j = await r.json();

  return {
    updateTime: j.updateTime,
    createTime: j.createTime,
    fields: readFields(j.fields || {})
  };
}

async function fsPatch(env, path, fields, token, updateTime) {
  const write = {
    update: {
      name: fsName(env, path),
      fields: fsFields(fields)
    },
    updateMask: {
      fieldPaths: Object.keys(fields).filter(k => fields[k] !== undefined)
    },
    currentDocument: updateTime ? { updateTime } : { exists: true }
  };

  const r = await fetch(fsBase(env) + ":commit", {
    method: "POST",
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ writes: [write] })
  });

  if (!r.ok) {
    const text = (await r.text()).slice(0, 500);

    const e = new Error("Firestore update failed: " + r.status + " " + text);

    e.precondition =
      r.status === 409 ||
      text.includes("FAILED_PRECONDITION") ||
      text.includes("ABORTED");

    throw e;
  }

  return r.json();
}

async function fsQuery(env, query, token) {
  const r = await fetch(fsBase(env) + ":runQuery", {
    method: "POST",
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ structuredQuery: query })
  });

  if (!r.ok)
    throw new Error(
      "Firestore query failed: " + r.status + " " + (await r.text()).slice(0, 500)
    );

  const rows = await r.json();

  return rows
    .filter(x => x.document)
    .map(x => ({
      id: x.document.name.split("/").pop(),
      updateTime: x.document.updateTime,
      fields: readFields(x.document.fields || {})
    }));
}

function filter(field, op, value) {
  return {
    fieldFilter: {
      field: { fieldPath: field },
      op,
      value
    }
  };
}

function and(filters) {
  return filters.length === 1
    ? filters[0]
    : { compositeFilter: { op: "AND", filters } };
}

/* =========================
   FCM
   ========================= */

function cleanData(data) {
  const out = {};

  for (const [k, v] of Object.entries(data || {})) {
    if (v !== undefined && v !== null) out[k] = String(v);
  }

  return out;
}

function isNative(platform) {
  return NATIVE_PLATFORMS.includes(String(platform || "").toLowerCase());
}

function platformOf(fields) {
  return (fields && (fields.fcmPlatform || fields.platform)) || "web";
}

function buildMessage(token, platform, data) {
  const d = cleanData(data);

  // logo for the web service worker to use in showNotification()
  if (ORIGIN) {
    d.icon = ORIGIN + "/logo.png";
    d.badge = ORIGIN + "/badge.png";
  }

  const message = {
    token,
    data: d,

    android: {
      priority: "HIGH",
      ttl: PUSH_TTL_SECONDS + "s"
    },

    webpush: {
      headers: {
        Urgency: "high",
        TTL: String(PUSH_TTL_SECONDS)
      }
    }
  };

  if (isNative(platform)) {
    message.notification = {
      title: d.title || "TruckConnect",
      body: d.body || ""
    };

    if (ORIGIN && SHOW_BANNER_ON_NATIVE)
      message.notification.image = ORIGIN + "/banner.png";

    message.android.notification = {
      channel_id: ANDROID_CHANNEL_ID,
      notification_priority: "PRIORITY_HIGH",
      default_sound: true
    };

    if (d.tag) message.android.notification.tag = d.tag;

    message.apns = {
      headers: {
        "apns-priority": "10",
        "apns-push-type": "alert",
        "apns-expiration": String(
          Math.floor(Date.now() / 1000) + PUSH_TTL_SECONDS
        )
      },
      payload: {
        aps: {
          sound: "default"
        }
      }
    };
  }

  return message;
}

function isDeadToken(status, text) {
  return (
    status === 404 ||
    text.includes("UNREGISTERED") ||
    text.includes("NOT_FOUND") ||
    text.includes("SENDER_ID_MISMATCH") ||
    text.includes("registration token is not a valid") ||
    (status === 400 && text.includes("INVALID_ARGUMENT") && text.includes("token"))
  );
}

async function sendFCM(env, token, platform, data, access) {
  try {
    const r = await fetch(
      "https://fcm.googleapis.com/v1/projects/" +
        encodeURIComponent(project(env)) +
        "/messages:send",
      {
        method: "POST",
        headers: {
          Authorization: "Bearer " + access,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          message: buildMessage(token, platform, data)
        })
      }
    );

    const text = await r.text();

    console.log(
      "[TruckConnect] FCM status=" + r.status + " kind=" + ((data && data.kind) || "") +
      " platform=" + platform + " body=" + text.slice(0, 300)
    );

    if (!r.ok) {
      return {
        ok: false,
        status: r.status,
        dead: isDeadToken(r.status, text),
        error: text.slice(0, 500)
      };
    }

    return { ok: true };
  } catch (e) {
    return { ok: false, status: 0, dead: false, error: String(e.message || e) };
  }
}

async function clearDeadToken(env, collection, uid, access, deadToken) {
  try {
    if (deadToken) {
      const cur = await fsGet(env, collection + "/" + encodeURIComponent(uid), access);
      if (!cur || cur.fields.fcmToken !== deadToken) return;
    }

    await fsPatch(
      env,
      collection + "/" + encodeURIComponent(uid),
      { fcmToken: "" },
      access
    );
  } catch (e) {
    console.error("[TruckConnect] token cleanup failed", e.message);
  }
}

/* =========================
   TRUCK MATCHING
   ========================= */

function tons(value) {
  const s = String(value || "").toLowerCase();

  const m = s.match(/(\d+(?:\.\d+)?)\s*-?\s*ton/);

  if (m) return Number(m[1]);

  if (s.includes("bakkie")) return 1;

  return null;
}

function driverMatches(d, b) {
  if (d.online !== true) return false;

  if (String(d.status || "").toLowerCase() !== "approved") return false;

  if (!d.fcmToken) return false;

  const requested = tons(b.truckV || b.truckType || b.truck);

  if (requested == null) return true;

  const driver = tons(d.truckType || d.truck);

  if (driver == null) return true;

  return driver === requested;
}

/* Heavy loads (over 10 ton): any VERIFIED truck that can carry the load, online or not */
function heavyEligible(d, b) {
  if (String(d.status || "").toLowerCase() !== "approved") return false;
  if (!d.fcmToken) return false;
  if (d.foreign === true) return false;
  if (d.entityType === "company" && d.companyStatus !== "verified") return false;
  const need = tons(b.truckV || b.truckType || b.truck);
  const have = tons(d.truckType || d.truck) || tons(d.payloadCapacity + " ton");
  return need != null && have != null && have >= need;
}

async function eligibleDrivers(env, booking, access) {
  if (booking && booking.heavy === true) {
    const all = await fsQuery(
      env,
      {
        from: [{ collectionId: "drivers" }],
        where: filter("status", "EQUAL", { stringValue: "approved" }),
        limit: 400
      },
      access
    );
    return all
      .filter(d => heavyEligible(d.fields, booking))
      .sort((a, b2) => (tons(a.fields.truckType) || 0) - (tons(b2.fields.truckType) || 0));
  }
  return eligibleDriversBase(env, booking, access);
}

async function eligibleDriversBase(env, booking, access) {
  const rows = await fsQuery(
    env,
    {
      from: [{ collectionId: "drivers" }],
      where: and([
        filter("online", "EQUAL", { booleanValue: true }),
        filter("status", "EQUAL", { stringValue: "approved" })
      ]),
      limit: 200
    },
    access
  );

  return rows.filter(d => driverMatches(d.fields, booking));
}

/* =========================
   ACTION TOKEN
   ========================= */

async function hmac(text, secret) {
  if (!secret) throw err(500, "ADMIN_API_SECRET is missing");

  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const sig = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(text)
  );

  return b64url(new Uint8Array(sig));
}

async function makeActionToken(env, driverUid, bookingId) {
  const payload = {
    driverUid,
    bookingId,
    exp: Math.floor(Date.now() / 1000) + ACTION_TOKEN_SECONDS
  };

  const raw = JSON.stringify(payload);

  const signature = await hmac(raw, env.ADMIN_API_SECRET);

  return b64url(new TextEncoder().encode(raw)) + "." + signature;
}

async function verifyActionToken(env, token) {
  const parts = String(token || "").split(".");

  if (parts.length !== 2) throw err(401, "Invalid action token");

  let raw;

  try {
    raw = new TextDecoder().decode(decode64(parts[0]));
  } catch {
    throw err(401, "Invalid action token");
  }

  const expected = await hmac(raw, env.ADMIN_API_SECRET);

  if (!constantTime(parts[1], expected))
    throw err(401, "Invalid action token");

  let p;

  try {
    p = JSON.parse(raw);
  } catch {
    throw err(401, "Invalid action token");
  }

  if (!p || !p.driverUid || !p.bookingId)
    throw err(401, "Invalid action token");

  if (p.exp < Math.floor(Date.now() / 1000))
    throw err(401, "Action token expired");

  return p;
}

function constantTime(a, b) {
  if (a.length !== b.length) return false;

  let result = 0;

  for (let i = 0; i < a.length; i++)
    result |= a.charCodeAt(i) ^ b.charCodeAt(i);

  return result === 0;
}

