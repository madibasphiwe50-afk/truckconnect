async function notifyFromApp(request, env) {
  const user = await firebaseUser(request, env);
  const body = await readBody(request);

  const toUid = String(body.toUid || "");
  const role = String(body.role || "");
  const rawData = body.data && typeof body.data === "object" ? body.data : {};
  const bookingId = String(body.bookingId || rawData.id || "");

  if (!toUid || !role) throw err(400, "toUid and role are required");

  if (role !== "customer" && role !== "driver")
    throw err(400, "role must be customer or driver");

  if (!bookingId) throw err(400, "bookingId is required");

  const access = await googleToken(env);

  const doc = await fsGet(
    env,
    "bookings/" + encodeURIComponent(bookingId),
    access
  );

  if (!doc) throw err(404, "Booking not found");

  const b = doc.fields;

  if (
    role === "customer" &&
    (b.driverUid !== user.localId || b.customerUid !== toUid)
  )
    throw err(403, "Unauthorized customer notification");

  if (
    role === "driver" &&
    (b.customerUid !== user.localId || (b.driverUid && b.driverUid !== toUid))
  )
    throw err(403, "Unauthorized driver notification");

  const collection = role === "customer" ? "customers" : "drivers";

  const target = await fsGet(
    env,
    collection + "/" + encodeURIComponent(toUid),
    access
  );

  console.log(
    "[TruckConnect] notify-from-app from=" + user.localId + " to=" + toUid + " role=" + role +
    " booking=" + bookingId + " hasToken=" + !!(target && target.fields.fcmToken)
  );

  if (!target || !target.fields.fcmToken)
    return json({
      ok: true,
      sent: false,
      reason: "no-fcm-token"
    });

  const data = {};

  for (const k of ALLOWED_DATA_KEYS) {
    if (rawData[k] !== undefined && rawData[k] !== null)
      data[k] = String(rawData[k]).slice(0, 200);
  }

  data.kind = data.kind || "status";
  data.title = fixRand(String(body.title || "TruckConnect").slice(0, 100));
  data.body = fixRand(String(body.body || "").slice(0, 300));
  data.screen = data.screen || "tracking";
  data.id = bookingId;
  data.bookingId = bookingId;
  data.app = role;

  const result = await sendFCM(
    env,
    target.fields.fcmToken,
    platformOf(target.fields),
    data,
    access
  );

  if (!result.ok && result.dead) {
    await clearDeadToken(env, collection, toUid, access, target.fields.fcmToken);
  }

  return json({
    ok: result.ok,
    sent: result.ok,
    ...(result.ok ? {} : { fcmStatus: result.status, reason: result.dead ? "stale-token-removed" : "fcm-error", detail: String(result.error || "").slice(0, 200) })
  });
}

