async function notifySelf(request, env, ctx) {
  const user = await firebaseUser(request, env);
  const body = await readBody(request);

  const role = String(body.role || "");

  if (role !== "driver" && role !== "customer")
    throw err(400, "role must be driver or customer");

  const delay = Math.min(20, Math.max(0, Number(body.delay) || 0));
  const access = await googleToken(env);
  const collection = role === "driver" ? "drivers" : "customers";
  const doc = await fsGet(env, collection + "/" + encodeURIComponent(user.localId), access);

  console.log("[TruckConnect] notify-self uid=" + user.localId + " role=" + role +
    " hasToken=" + !!(doc && doc.fields.fcmToken) + " delay=" + delay);

  if (!doc || !doc.fields.fcmToken)
    return json({ ok: false, sent: false, reason: "no-fcm-token" });

  const token = doc.fields.fcmToken;
  const platform = platformOf(doc.fields);

  const data = {
    kind: "welcome",
    title: "Welcome to Truck Connect 🚛",
    body: "Push notifications are working on this phone.",
    screen: "home",
    app: role,
    tag: "tc-welcome"
  };

  const send = async () => {
    const result = await sendFCM(env, token, platform, data, access);

    if (!result.ok && result.dead)
      await clearDeadToken(env, collection, user.localId, access, token);

    return result;
  };

  if (delay > 0) {
    ctx.waitUntil(
      new Promise(r => setTimeout(r, delay * 1000)).then(send).catch(e =>
        console.error("[TruckConnect] delayed welcome failed", e.message)
      )
    );

    return json({ ok: true, scheduled: true, delay });
  }

  const result = await send();

  return json({
    ok: result.ok,
    sent: result.ok,
    ...(result.ok ? {} : { fcmStatus: result.status, reason: result.dead ? "stale-token-removed" : "fcm-error", detail: String(result.error || "").slice(0, 200) })
  });
}

