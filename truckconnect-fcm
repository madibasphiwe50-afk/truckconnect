   ACCEPT / DECLINE
   ========================= */

async function notificationAction(request, env) {
  const body = await readBody(request);

  const action = String(body.action || "").toLowerCase();

  if (action !== "accept" && action !== "decline")
    throw err(400, "Action must be accept or decline");

  const token = await verifyActionToken(env, body.token);

  const access = await googleToken(env);

  const booking = await fsGet(
    env,
    "bookings/" + encodeURIComponent(token.bookingId),
    access
  );

  if (!booking) throw err(404, "Booking not found");

  const b = booking.fields;

  if (
    b.ds !== "avail" &&
    !(b.ds === "requested" && b.driverUid === token.driverUid)
  )
    return json(
      {
        ok: false,
        reason: "job-no-longer-available"
      },
      409
    );

  if (action === "decline") {
    return json({
      ok: true,
      action: "decline",
      bookingId: token.bookingId
    });
  }

  if (b.heavy === true && !(b.ds === "requested" && b.driverUid === token.driverUid && b.counterAccepted === true))
    return json({ ok: false, reason: "quote-required" }, 409);

  const driver = await fsGet(
    env,
    "drivers/" + encodeURIComponent(token.driverUid),
    access
  );

  if (!driver) throw err(404, "Driver not found");

  const d = driver.fields;

  if (String(d.status || "").toLowerCase() !== "approved")
    throw err(403, "Driver is not approved");

  const update = {
    ds: "accepted",
    driverUid: token.driverUid,
    acceptedAt: new Date().toISOString(),
    driverName: String(d.name || d.fullName || "Driver"),
    driverPhone: String(d.phone || ""),
    driverPhotoUrl: String(d.photo || d.photoUrl || ""),
    driverTruck: String(d.truckType || d.truck || ""),
    driverPlate: String(d.plate || d.numPlate || "")
  };

  try {
    await fsPatch(
      env,
      "bookings/" + encodeURIComponent(token.bookingId),
      update,
      access,
      booking.updateTime
    );
  } catch (e) {
    if (e.precondition) {
      return json(
        {
          ok: false,
          reason: "job-already-taken"
        },
        409
      );
    }

    throw e;
  }

  const customer = await fsGet(
    env,
    "customers/" + encodeURIComponent(b.customerUid),
    access
  );

  if (customer && customer.fields.fcmToken) {
    const result = await sendFCM(
      env,
      customer.fields.fcmToken,
      platformOf(customer.fields),
      {
        kind: "driver_accepted",
        title: "🚛 Driver Accepted",
        body: update.driverName + " has accepted your booking.",
        screen: "tracking",
        app: "customer",
        id: token.bookingId,
        bookingId: token.bookingId
      },
      access
    );

    if (!result.ok && result.dead) {
      await clearDeadToken(env, "customers", b.customerUid, access, customer.fields.fcmToken);
    }
  }

  return json({
    ok: true,
    action: "accept",
    bookingId: token.bookingId,
    driverUid: token.driverUid
  });
}

